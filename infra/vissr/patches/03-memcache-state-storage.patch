index ef959bd6..420d4465 100755
--- a/server/vissv2server/memcacheNativeInit.sh
+++ b/server/vissv2server/memcacheNativeInit.sh
@@ -1,3 +1,6 @@
-#! /usr/bin/bash
-memcached -d --unix-mask=755 --unix-socket=/var/tmp/vissv2/memcacheDB.sock
-
+#!/usr/bin/env bash
+mkdir -p /var/tmp/vissv2
+# memcached refuses to run as root unless the user is given, e.g. in a container
+USER_ARG=()
+[ "$(id -u)" -eq 0 ] && USER_ARG=(-u root)
+memcached -d "${USER_ARG[@]}" --unix-mask=755 --unix-socket=/var/tmp/vissv2/memcacheDB.sock
