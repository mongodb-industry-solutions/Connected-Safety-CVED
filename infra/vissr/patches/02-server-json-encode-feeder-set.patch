+// feederSetMessage builds the set message sent to the feeder. The path and value are JSON encoded,
+// so that values containing quotes or backslashes, e.g. a JSON array, do not produce malformed JSON.
+func feederSetMessage(path, value, ts string) string {
+	return `{"action": "set", "data": {"path":` + jsonString(path) + `, "dp":{"value":` + jsonString(value) + `, "ts":"` + ts + `"}}}`
+}
+
+func jsonString(s string) string {
+	b, _ := json.Marshal(s) // marshalling a string cannot fail
+	return string(b)
+}
+
