+// TestRedisBackend_SetEscapesValue verifies that a value containing quotes, e.g. a JSON array
+// of time series values, produces a feeder message that is valid JSON and keeps the value intact.
+func TestRedisBackend_SetEscapesValue(t *testing.T) {
+	feeder := make(chan string, 1)
+	b := newRedisBackend(nil, feeder)
+	value := `["118", "95", "75"]`
+	b.Set("Vehicle.Speed", value)
+	msg := <-feeder
+	var messageMap map[string]interface{}
+	if err := json.Unmarshal([]byte(msg), &messageMap); err != nil {
+		t.Fatalf("feeder message is not valid JSON: %v, message=%s", err, msg)
+	}
+	data := messageMap["data"].(map[string]interface{})
+	got := data["dp"].(map[string]interface{})["value"]
+	if got != value {
+		t.Errorf("value = %q, want %q", got, value)
+	}
+}
