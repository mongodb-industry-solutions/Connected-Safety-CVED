HIM:
type: branch
description: Defines the set of trees that are managed as one virtual domain.

HIM.Vehicle:
type: direct
domain: Vehicle.Car.VehicleData
version: 6.1
local: forest/VehicleSignalSpecificationv6.1.binary
#public: https://himrepo.oem.com?instance=Vehicle.Car.Data.X.Y.Z
description: The VSS v6.1 tree plus Safety.IsReleased and Seat.Weight

HIM.Occupant1:
type: direct
domain: Vehicle.Occupant.Data
version: 0.1
local: forest/OccupantSpecificationv0.1.binary
#public: https://himrepo.oem.com?instance=Vehicle.Car.TypeDefinition.X.Y.Z
description: Occupant tree representing the driver.

HIM.CVED:
type: direct
domain: Vehicle.CVED.Data
version: 0.1
local: forest/CVED_Specificationv0.1.binary
#public: https://himrepo.oem.com?instance=Vehicle.Car.TypeDefinition.X.Y.Z
description: Connected Vehicle Emergency Dataset.

HIM.Server:
type: direct
domain: Server.Capabilities.Data
version: 0.1
local: forest/server.binary
#public: https://himrepo.oem.com?instance=Server.Capabilities.Data.X.Y.Z
description: The server capabilities tree.
